[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../rust/target/debug/libbf_game.so"
linux.release.x86_64 = "res://../rust/target/release/libbf_game.so"
windows.debug.x86_64 = "res://../rust/target/debug/bf_game.dll"
windows.release.x86_64 = "res://../rust/target/release/bf_game.dll"

[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/driftloom/bin/linux/libdriftloom_godot.so"
linux.release.x86_64 = "res://addons/driftloom/bin/linux/libdriftloom_godot.so"
windows.debug.x86_64 = "res://addons/driftloom/bin/windows/driftloom_godot.dll"
windows.release.x86_64 = "res://addons/driftloom/bin/windows/driftloom_godot.dll"
android.debug.arm64 = "res://addons/driftloom/bin/android/arm64/libdriftloom_godot.so"
android.release.arm64 = "res://addons/driftloom/bin/android/arm64/libdriftloom_godot.so"
android.debug.arm32 = "res://addons/driftloom/bin/android/arm32/libdriftloom_godot.so"
android.release.arm32 = "res://addons/driftloom/bin/android/arm32/libdriftloom_godot.so"
web.debug.wasm32 = "res://addons/driftloom/bin/web/driftloom_godot.wasm"
web.release.wasm32 = "res://addons/driftloom/bin/web/driftloom_godot.wasm"
